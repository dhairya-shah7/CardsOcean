{
  "name": "elitepay-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "node kill-port.js && npm --workspace apps/api run dev",
    "start:all": "cmd /c start-all.cmd",
    "build": "npm-run-all build:api build:web",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "lint": "npm-run-all lint:api lint:web",
    "lint:web": "npm --workspace apps/web run lint",
    "lint:api": "npm --workspace apps/api run lint",
    "seed": "npm --workspace apps/api run seed",
    "test:api": "npm --workspace apps/api run test",
    "db:studio": "npx prisma studio --schema=apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "^6.8.2",
    "npm-run-all": "^4.1.5",
    "prisma": "^6.8.2"
  }
}
